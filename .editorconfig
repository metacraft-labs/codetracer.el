# EditorConfig: https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[Justfile]
indent_size = 4

# Lisp is indented by its structure (Emacs's own indentation), not in steps.
[*.el]
indent_size = unset
